# .env - Variables de entorno para Docker Compose
# =================================================================
# Copiar este archivo a .env y ajustar las contraseñas
# =================================================================

# PostgreSQL Configuration
POSTGRES_USER=pfm_user
POSTGRES_PASSWORD=pfm_pa…2026
POSTGRES_DB=pfm_datasets
POSTGRES_PORT=5432

# pgAdmin Configuration (opcional)
PGADMIN_EMAIL=admin@pfm.example.com
PGADMIN_PASSWORD=***
PGADMIN_PORT=5050

# Modelo de embeddings (para futuro backend)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# API de datos.gob.es (configuración opcional)
DATOS_GOB_ES_API=https://datos.gob.es/apidata/catalog/dataset
API_PAGE_SIZE=100

# Logging
LOG_LEVEL=info
