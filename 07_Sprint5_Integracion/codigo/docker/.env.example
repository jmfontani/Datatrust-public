# API REST
API_PORT=8000

# Frontend Streamlit
FRONTEND_PORT=8501

# Ollama Cloud (externo, no se conteneriza)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=tu_api_key_aqui